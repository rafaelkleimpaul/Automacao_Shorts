# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=shorts
POSTGRES_PASSWORD=shorts_secret
POSTGRES_DB=shorts_db

# ── n8n ───────────────────────────────────────────────────────────────────────
# Must be exactly 32+ characters.
N8N_ENCRYPTION_KEY=change_me_to_a_random_32char_string

# ── Timezone ─────────────────────────────────────────────────────────────────
TIMEZONE=America/New_York

# ── Content defaults ──────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en_US
DEFAULT_NICHE=finance
DEFAULT_STYLE=commentary
DEFAULT_DURATION=30

# ── Pluggable local AI services ───────────────────────────────────────────────
# LLM  — Ollama example (running on host):
LLM_ENDPOINT=http://host.docker.internal:11434/api/generate
LLM_MODEL=llama3

# TTS  — Coqui / Piper / custom REST example (running on host):
TTS_ENDPOINT=http://host.docker.internal:5500/synthesize
TTS_VOICE=en-US-Standard-D
TTS_SPEED=1.0

# ASR  — Whisper / faster-whisper REST example (running on host):
ASR_ENDPOINT=http://host.docker.internal:9000/transcribe

# ── Worker ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_RETRIES=3
