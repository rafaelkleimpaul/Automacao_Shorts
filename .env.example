# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=shorts
POSTGRES_PASSWORD=shorts_secret
POSTGRES_DB=shorts_db

# ── n8n ───────────────────────────────────────────────────────────────────────
# Must be exactly 32+ characters.
N8N_ENCRYPTION_KEY=change_me_to_a_random_32char_string

# ── Timezone ─────────────────────────────────────────────────────────────────
TIMEZONE=America/New_York

# ── Content defaults ──────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en_US
DEFAULT_NICHE=finance
DEFAULT_STYLE=commentary
DEFAULT_DURATION=30

# ── Pluggable local AI services ───────────────────────────────────────────────
# LLM  — Ollama example (running on host):
LLM_ENDPOINT=http://host.docker.internal:11434/api/generate
LLM_MODEL=llama3

# TTS  — Coqui / Piper / custom REST example (running on host):
TTS_ENDPOINT=http://host.docker.internal:5500/synthesize
TTS_VOICE=en-US-Standard-D
TTS_SPEED=1.0

# ASR  — Whisper / faster-whisper REST example (running on host):
ASR_ENDPOINT=http://host.docker.internal:9000/transcribe

# ── Security ──────────────────────────────────────────────────────────────────
# API key required on all endpoints (X-API-Key header).
# Generate a strong key: openssl rand -hex 32
API_KEY=change_me_to_a_strong_random_key

# ── Worker ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_RETRIES=3

# ═══════════════════════════════════════════════════════════════════════════════
# AUTO-PUBLISHING  (all disabled by default)
# Enable only after completing the auth setup for each platform.
# ═══════════════════════════════════════════════════════════════════════════════

# ── YouTube ───────────────────────────────────────────────────────────────────
# Setup: python scripts/auth_youtube.py
# Token stored at: ./data/credentials/youtube_token.json
YOUTUBE_ENABLED=false
YOUTUBE_PRIVACY=public          # public | unlisted | private
YOUTUBE_CATEGORY_ID=27          # 27=Education  22=People&Blogs  25=News

# ── Instagram ─────────────────────────────────────────────────────────────────
# Setup: python scripts/auth_instagram.py
# Requires PUBLIC_BASE_URL so Instagram can fetch the video file.
INSTAGRAM_ENABLED=false
INSTAGRAM_USER_ID=              # numeric ID from auth_instagram.py
INSTAGRAM_ACCESS_TOKEN=         # long-lived token (60 days) from auth_instagram.py

# PUBLIC_BASE_URL — URL where the worker is publicly reachable.
# Options:
#   ngrok:             ngrok http 8000  →  use the https://xxxx.ngrok-free.app URL
#   Cloudflare Tunnel: cloudflared tunnel --url http://localhost:8000
#   Own domain/VPS:    https://your-domain.com (with reverse proxy to port 8000)
PUBLIC_BASE_URL=                # e.g. https://abc123.ngrok-free.app

# ── Telegram notifications ────────────────────────────────────────────────────
# Create a bot via @BotFather and get the chat ID from getUpdates.
# Leave blank to disable all Telegram notifications.
TELEGRAM_BOT_TOKEN=              # e.g. 123456789:ABCdef...
TELEGRAM_CHAT_ID=                # e.g. -100123456789 (group) or 12345678 (personal)

# ── TikTok ────────────────────────────────────────────────────────────────────
# Setup: python scripts/auth_tiktok.py
# Token stored at: ./data/credentials/tiktok_token.json (auto-refreshed)
TIKTOK_ENABLED=false
TIKTOK_CLIENT_KEY=              # from developers.tiktok.com → your app
TIKTOK_CLIENT_SECRET=           # from developers.tiktok.com → your app
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE   # PUBLIC_TO_EVERYONE | FOLLOWER_OF_CREATOR | SELF_ONLY
